# Zalo API Service Configuration
# Copy this file to .env and update the values

# ============================================================
# SECURITY (IMPORTANT - Change this!)
# ============================================================
ZALO_API_KEY=your-super-secret-api-key-change-this

# ============================================================
# RATE LIMITING
# ============================================================
# Maximum requests per minute per API key
RATE_LIMIT_PER_MINUTE=60

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Comma-separated list of allowed origins
# Use "*" to allow all origins (not recommended for production)
CORS_ORIGINS=*
# Example: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================================
# WEBHOOK (Optional)
# ============================================================
# URL to receive webhook events when new messages arrive
WEBHOOK_URL=

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=10000
HOST=0.0.0.0

# ============================================================
# DATA STORAGE
# ============================================================
# Session file location (inside container)
ZALO_SESSION=/app/data/zalo_session.json
HERMES_HOME=/app/data
