# Zalo API Service Configuration
# NO AUTHENTICATION REQUIRED - PUBLIC ACCESS

# Leave empty to disable auth
ZALO_API_KEY=

# Rate limiting (disabled when auth is off)
RATE_LIMIT_PER_MINUTE=1000

# CORS - allow all
CORS_ORIGINS=*

# Server
PORT=10000
HOST=0.0.0.0

# Data storage
ZALO_SESSION=/app/data/zalo_session.json
HERMES_HOME=/app/data
